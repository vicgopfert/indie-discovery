# Banco de dados (Docker Compose local; em produção, a URL do Neon)
DATABASE_URL="postgresql://indie:indie@localhost:5432/indie?schema=public"

# API (local: 3001; no Render, a plataforma define PORT)
PORT=3001

# Frontend: endereço da API para o rewrite de /api/* (no Vercel, a URL do Render)
API_URL="http://localhost:3001"

# Sessão
SESSION_TTL_DAYS=7
WEB_ORIGIN="http://localhost:3000"

# IGDB (somente a aplicação de ingestão usa; a API nunca recebe estas variáveis)
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""

# Segredo da rota interna de recarga do índice de conteúdo
INTERNAL_RELOAD_SECRET=""

NODE_ENV="development"
