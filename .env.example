# Variáveis da API validadas na inicialização (apps/api/src/config/env.ts):
# se faltar uma obrigatória, a API não sobe e informa qual.

# Banco de dados (local: pnpm db:start; em produção, a URL do Neon)
DATABASE_URL="postgresql://indie:indie@localhost:5432/indie?schema=public"

# API (opcional, padrão 3001; no Render, a plataforma define PORT)
PORT=3001

# Frontend: endereço da API para o rewrite de /api/* (no Vercel, a URL do Render)
API_URL="http://localhost:3001"

# Sessão (SESSION_TTL_DAYS opcional, padrão 7)
SESSION_TTL_DAYS=7
WEB_ORIGIN="http://localhost:3000"

# IGDB (somente a aplicação de ingestão usa; a API nunca recebe estas variáveis)
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""

# Segredo da rota interna de recarga do índice de conteúdo, com 32 caracteres ou mais.
# Em produção, gere um novo: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
INTERNAL_RELOAD_SECRET="segredo-local-de-desenvolvimento-troque-em-producao"

# development, test ou production (opcional, padrão development)
NODE_ENV="development"
