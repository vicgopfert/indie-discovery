generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ReleaseStatus {
  RELEASED
  UPCOMING
}

enum StudioCountrySource {
  IGDB
  WIKIDATA
}

enum FeatureType {
  GENRE
  THEME
  KEYWORD
}

enum IngestionStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum UserRole {
  USER
  ADMIN
}

enum DiscoveryMode {
  POPULAR
  BALANCED
  DISCOVERY
}

enum ReviewFlagKind {
  NO_EFFECT_STUDIO
  PARENT_OUTSIDE_MAJORS
  PARENT_MAJOR_NOT_CONTROLLED
  RELEASE_DATE_ASSIGNED
  VERDICT_CHANGED
  LEFT_CANDIDATE_SET
  NO_DEVELOPER_VISIBLE
  COLLECTION_GAME_OUT_OF_CATALOG
}

enum ListType {
  FAVORITE
  COMPLETED
  WANT_TO_PLAY
}

// E-mail guardado já normalizado (minúsculas, sem espaços): o índice único garante a unicidade.
model User {
  id                    String           @id @default(uuid()) @db.Uuid
  email                 String           @unique
  passwordHash          String
  displayName           String
  role                  UserRole         @default(USER)
  discoveryMode         DiscoveryMode    @default(BALANCED)
  onboardingCompletedAt DateTime?
  createdAt             DateTime         @default(now())
  sessions              Session[]
  ratings               Rating[]
  listEntries           ListEntry[]
  preferences           UserPreference[]
}

// Guarda só o hash SHA-256 do token; o token em si existe apenas no cookie do navegador.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// A nota de 1 a 5 é garantida por uma CHECK na migration, que o Prisma não declara no schema.
// A ingestão nunca apaga jogos nem atributos (o jogo sai do catálogo por inCatalog), e o
// Restrict impede que uma exclusão manual leve avaliações, listas e preferências em silêncio.
model Rating {
  userId    String   @db.Uuid
  gameId    String   @db.Uuid
  score     Int
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Restrict)

  @@id([userId, gameId])
}

model ListEntry {
  userId    String   @db.Uuid
  gameId    String   @db.Uuid
  listType  ListType
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Restrict)

  @@id([userId, gameId, listType])
}

model UserPreference {
  userId    String   @db.Uuid
  featureId String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature   Feature  @relation(fields: [featureId], references: [id], onDelete: Restrict)

  @@id([userId, featureId])
}

model Country {
  code      Int       @id
  alpha2    String    @unique @db.Char(2)
  namePt    String
  companies Company[]
  games     Game[]
}

model Language {
  id     String         @id @default(uuid()) @db.Uuid
  igdbId Int            @unique
  locale String
  namePt String
  games  GameLanguage[]
}

model Company {
  id          String        @id @default(uuid()) @db.Uuid
  igdbId      Int           @unique
  name        String
  countryCode Int?
  country     Country?      @relation(fields: [countryCode], references: [code])
  games       GameCompany[]

  @@index([countryCode])
}

model Feature {
  id          String           @id @default(uuid()) @db.Uuid
  type        FeatureType
  igdbId      Int
  name        String
  slug        String
  idf         Float            @default(0)
  games       GameFeature[]
  preferences UserPreference[]

  @@unique([type, igdbId])
}

model Game {
  id                  String               @id @default(uuid()) @db.Uuid
  igdbId              Int                  @unique
  slug                String               @unique
  name                String
  summary             String
  coverImageId        String
  firstReleaseDate    DateTime?            @db.Date
  releaseStatus       ReleaseStatus
  popularityCount     Int                  @default(0)
  popularityNorm      Float                @default(0)
  inCatalog           Boolean
  criteriaVerdict     Json
  criteriaVersion     String
  storeUrl            String?
  studioCountryCode   Int?
  studioCountry       Country?             @relation(fields: [studioCountryCode], references: [code])
  studioCountrySource StudioCountrySource?
  syncedAt            DateTime
  companies           GameCompany[]
  features            GameFeature[]
  languages           GameLanguage[]
  collections         CollectionGame[]
  ratings             Rating[]
  listEntries         ListEntry[]

  @@index([inCatalog, releaseStatus])
  @@index([studioCountryCode])
}

model GameCompany {
  gameId      String  @db.Uuid
  companyId   String  @db.Uuid
  isDeveloper Boolean @default(false)
  isPublisher Boolean @default(false)
  game        Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([gameId, companyId])
}

model GameFeature {
  gameId    String  @db.Uuid
  featureId String  @db.Uuid
  game      Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([gameId, featureId])
  @@index([featureId])
}

model GameLanguage {
  gameId     String   @db.Uuid
  languageId String   @db.Uuid
  interface  Boolean  @default(false)
  subtitles  Boolean  @default(false)
  audio      Boolean  @default(false)
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@id([gameId, languageId])
}

// Coleção cultural curada em config/collections.json; a ingestão sincroniza o arquivo com o banco.
model Collection {
  id          String           @id @default(uuid()) @db.Uuid
  slug        String           @unique
  name        String
  description String
  sortOrder   Int
  games       CollectionGame[]
}

model CollectionGame {
  collectionId String     @db.Uuid
  gameId       String     @db.Uuid
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  game         Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([collectionId, gameId])
  @@index([gameId])
}

model IngestionRun {
  id               String                @id @default(uuid()) @db.Uuid
  startedAt        DateTime              @default(now())
  evaluatedAt      DateTime
  finishedAt       DateTime?
  status           IngestionStatus       @default(RUNNING)
  gamesFetched     Int                   @default(0)
  gamesUpserted    Int                   @default(0)
  gamesRejected    Int                   @default(0)
  gamesInvalid     Int                   @default(0)
  gamesDeactivated Int                   @default(0)
  flagsRaised      Int                   @default(0)
  criteriaVersion  String?
  popularityUnit   Float?
  popularityMax    Int?
  popularityMedian Float?
  errorSummary     String?
  reviewFlags      IngestionReviewFlag[]
}

model IngestionReviewFlag {
  id        String         @id @default(uuid()) @db.Uuid
  runId     String         @db.Uuid
  run       IngestionRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind      ReviewFlagKind
  igdbId    Int
  gameName  String
  detail    Json
  createdAt DateTime       @default(now())

  @@index([runId])
  @@index([kind])
}
