generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ReleaseStatus {
  RELEASED
  UPCOMING
}

enum StudioCountrySource {
  IGDB
  WIKIDATA
}

enum FeatureType {
  GENRE
  THEME
  KEYWORD
}

enum IngestionStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model Country {
  code      Int       @id
  alpha2    String    @unique @db.Char(2)
  namePt    String
  companies Company[]
  games     Game[]
}

model Language {
  id     String         @id @default(uuid()) @db.Uuid
  igdbId Int            @unique
  locale String
  namePt String
  games  GameLanguage[]
}

model Company {
  id          String        @id @default(uuid()) @db.Uuid
  igdbId      Int           @unique
  name        String
  countryCode Int?
  country     Country?      @relation(fields: [countryCode], references: [code])
  games       GameCompany[]

  @@index([countryCode])
}

model Feature {
  id     String        @id @default(uuid()) @db.Uuid
  type   FeatureType
  igdbId Int
  name   String
  slug   String
  idf    Float         @default(0)
  games  GameFeature[]

  @@unique([type, igdbId])
}

model Game {
  id                  String               @id @default(uuid()) @db.Uuid
  igdbId              Int                  @unique
  slug                String               @unique
  name                String
  summary             String
  coverImageId        String
  firstReleaseDate    DateTime?            @db.Date
  releaseStatus       ReleaseStatus
  popularityRaw       Int                  @default(0)
  popularityNorm      Float                @default(0)
  isIndie             Boolean
  storeUrl            String?
  studioCountryCode   Int?
  studioCountry       Country?             @relation(fields: [studioCountryCode], references: [code])
  studioCountrySource StudioCountrySource?
  syncedAt            DateTime
  companies           GameCompany[]
  features            GameFeature[]
  languages           GameLanguage[]

  @@index([isIndie, releaseStatus])
  @@index([studioCountryCode])
}

model GameCompany {
  gameId      String  @db.Uuid
  companyId   String  @db.Uuid
  isDeveloper Boolean @default(false)
  isPublisher Boolean @default(false)
  game        Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([gameId, companyId])
}

model GameFeature {
  gameId      String  @db.Uuid
  featureId   String  @db.Uuid
  tfidfWeight Float   @default(0)
  game        Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  feature     Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([gameId, featureId])
  @@index([featureId])
}

model GameLanguage {
  gameId     String   @db.Uuid
  languageId String   @db.Uuid
  interface  Boolean  @default(false)
  subtitles  Boolean  @default(false)
  audio      Boolean  @default(false)
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@id([gameId, languageId])
}

model IngestionRun {
  id            String          @id @default(uuid()) @db.Uuid
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?
  status        IngestionStatus @default(RUNNING)
  gamesFetched  Int             @default(0)
  gamesUpserted Int             @default(0)
  gamesRejected Int             @default(0)
  errorSummary  String?
}
